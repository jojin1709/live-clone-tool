{
  "name": "living-clone",
  "version": "2.0.0",
  "description": "Advanced website cloning and comprehensive security testing tool - XSS, SQLi, CSRF, XXE, SSRF, LFI, Command Injection, Path Traversal, and more",
  "main": "clone.js",
  "bin": {
    "living-clone": "./clone.js",
    "lc": "./clone.js"
  },
  "scripts": {
    "start": "node clone.js",
    "test": "node clone.js clone https://example.com -o test --no-interactive --export-html --export-json",
    "scan": "node clone.js security",
    "dashboard": "node clone.js dashboard",
    "api": "node clone.js api",
    "help": "node clone.js --help"
  },
  "keywords": [
    "security",
    "xss",
    "sqli",
    "csrf",
    "xxe",
    "ssrf",
    "lfi",
    "command-injection",
    "path-traversal",
    "pentesting",
    "cloning",
    "web-scanner",
    "bug-bounty",
    "ethical-hacking",
    "reconnaissance",
    "vulnerability-scanner"
  ],
  "author": "JOJIN JOHN",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jojinjohn/living-clone/issues"
  },
  "homepage": "https://github.com/jojinjohn/living-clone#readme",
  "dependencies": {
    "archiver": "^6.0.1",
    "axios": "^1.4.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "chokidar": "^3.5.3",
    "commander": "^11.0.0",
    "eventemitter3": "^5.0.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.2",
    "inquirer": "^8.2.6",
    "open": "^8.4.2",
    "pdfkit": "^0.13.0",
    "puppeteer": "^21.0.0",
    "socks-proxy-agent": "^8.0.2",
    "tough-cookie": "^4.1.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.13.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ]
}
